# Gatefit access checks ({{TEMPLATE}} template), generated by `gatefit init`.
# Asserts the gatefit_access row after each billing transition. HTTP 200 from Stripe is not access.
# Fixture goldens need no Stripe key and no stored secrets at all.
# The Postgres service is throwaway (trust auth, no password). Database setup is
# yours: swap it for however your CI provides a disposable database.
name: gatefit
on: [push, pull_request]
jobs:
  access:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:17
        env:
          POSTGRES_HOST_AUTH_METHOD: trust
        ports: ["5432:5432"]
        options: >-
          --health-cmd pg_isready --health-interval 5s --health-timeout 5s --health-retries 10
    env:
      DATABASE_URL: postgres://postgres@localhost:5432/postgres
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      # The adapter needs pg from your project (npm install --save-dev pg).
      - run: npm ci
      - run: psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f {{MIGRATION}}
      - uses: gatefit/gatefit@v{{GATEFIT_VERSION}}
        with:
          adapter: {{DIR}}/adapter.ts
