// Access contract and reference entitlement rules, generated by `gatefit init`.
// Self-contained: nothing here imports Gatefit, so this file is yours to change.
// The types mirror the contract `gatefit run` drives (apply, snapshot, reset).
//
// nextSnapshot() is a copy of Gatefit's reference rules, the ones the free
// goldens model. Replace it with the function your webhook handler uses, then
// run the full free suite (tests/entitlements/goldens) to see what still holds.

/** The access row Gatefit asserts after each transition. locked: true means deny. */
export type AccessSnapshot = {
  locked: boolean;
  plan?: string;
  seats?: number;
  features?: string[];
};

/** One billing transition, normalized from a Stripe event by the golden. */
export type BillingEvent = {
  id: string;
  type: string;
  customerId: string;
  plan?: string;
  seats?: number;
  features?: string[];
  paid?: boolean;
  canceled?: boolean;
  refunded?: boolean;
  status?: string;
  httpStatus?: number;
  stripeHttpStatus?: number;
  cancel_at_period_end?: boolean;
  downgrade_at_period_end?: boolean;
  pending_plan?: string;
  period_end?: number;
  now?: number;
  created?: number;
};

export type AccessAdapter = {
  apply(event: BillingEvent): void | Promise<void>;
  snapshot(customerId: string): AccessSnapshot | Promise<AccessSnapshot>;
  reset?: () => void | Promise<void>;
};

const isPaid = (e: BillingEvent) => e.type === "invoice.paid" || e.paid === true;

const isImmediateCancel = (e: BillingEvent) =>
  e.canceled === true ||
  e.status === "canceled" ||
  e.type === "customer.subscription.deleted" ||
  e.type === "customer.subscription.canceled";

const isCapePeriodEnded = (e: BillingEvent) =>
  e.cancel_at_period_end === true &&
  typeof e.now === "number" &&
  typeof e.period_end === "number" &&
  e.now >= e.period_end;

const isDispute = (e: BillingEvent) =>
  e.type === "charge.dispute.created" || e.type === "radar.early_fraud_warning.created";

const isRefund = (e: BillingEvent) => e.refunded === true || e.type === "charge.refunded";

const isUnpaidExhaust = (e: BillingEvent) => e.status === "unpaid" || e.type === "invoice.marked_uncollectible";

const isPastDue = (e: BillingEvent) => e.status === "past_due" || e.type === "invoice.payment_failed";

const isTrialing = (e: BillingEvent) => e.status === "trialing";

const isPaused = (e: BillingEvent) => e.status === "paused" || e.type === "customer.subscription.paused";

const isTrialWillEnd = (e: BillingEvent) => e.type === "customer.subscription.trial_will_end";

const isActiveEntitlementSummary = (e: BillingEvent) => e.type === "entitlements.active_entitlement_summary.updated";

const isScheduledDowngrade = (e: BillingEvent) => e.downgrade_at_period_end === true && e.pending_plan !== undefined;

const isScheduledDowngradeDue = (e: BillingEvent) =>
  isScheduledDowngrade(e) && typeof e.now === "number" && typeof e.period_end === "number" && e.now >= e.period_end;

function withEntitlements(base: AccessSnapshot, event: BillingEvent): AccessSnapshot {
  const next: AccessSnapshot = { ...base };
  if (event.plan !== undefined) next.plan = event.plan;
  if (event.seats !== undefined) next.seats = event.seats;
  if (event.features !== undefined) next.features = event.features;
  return next;
}

export function nextSnapshot(current: AccessSnapshot, event: BillingEvent): AccessSnapshot {
  if (isDispute(event)) return { ...current, locked: true, features: [] };
  // A trial-ending warning neither grants nor revokes, even with HTTP 200.
  if (isTrialWillEnd(event)) return withEntitlements(current, event);
  // Active entitlement summaries replace features. They are not a payment.
  if (isActiveEntitlementSummary(event)) return { ...current, features: event.features ?? [] };
  if (isTrialing(event) || isPaused(event)) return withEntitlements({ ...current, locked: true }, event);
  if (isRefund(event) || isImmediateCancel(event) || isPastDue(event) || isUnpaidExhaust(event)) {
    return { ...current, locked: true };
  }
  if (isCapePeriodEnded(event)) return { ...current, locked: true };
  if (isScheduledDowngrade(event) && !isScheduledDowngradeDue(event)) return current;
  if (isScheduledDowngradeDue(event)) {
    const next = withEntitlements({ ...current }, event);
    next.plan = event.pending_plan;
    return next;
  }
  if (isPaid(event)) return withEntitlements({ ...current, locked: false }, event);
  if (
    event.type === "customer.subscription.updated" &&
    (event.cancel_at_period_end === true ||
      event.seats !== undefined ||
      event.plan !== undefined ||
      event.features !== undefined)
  ) {
    return withEntitlements(current, event);
  }
  return current;
}
