// Drizzle definitions for the Gatefit access tables, generated by `gatefit init`.
// Matches {{DIR}}/migration.sql. Add this file to drizzle.config.ts `schema` if you
// want drizzle-kit to own the tables, or apply migration.sql as is.
import { boolean, integer, pgTable, text, timestamp } from "drizzle-orm/pg-core";

export const gatefitAccess = pgTable("gatefit_access", {
  customerId: text("customer_id").primaryKey(),
  locked: boolean("locked").notNull().default(true),
  plan: text("plan"),
  seats: integer("seats"),
  features: text("features").array(),
  updatedAt: timestamp("updated_at", { withTimezone: true }).notNull().defaultNow(),
});

export const gatefitSeenEvents = pgTable("gatefit_seen_events", {
  eventId: text("event_id").primaryKey(),
  seenAt: timestamp("seen_at", { withTimezone: true }).notNull().defaultNow(),
});
