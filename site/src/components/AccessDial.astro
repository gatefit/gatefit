const stations = [
	{ id: 'trial', name: 'trial_to_paid_grants', chip: 'trialing', open: true, app: true, icon: 'hourglass', lx: 40.476, ly: 8.158, align: 'center', sx: 47.976, sy: 17.5 },
	{ id: 'paid', name: 'paid_grants_access', chip: 'invoice.paid', open: true, app: true, icon: 'card', lx: 68.179, ly: 18.368, align: 'start', sx: 64.071, sy: 23.276 },
	{ id: 'duplicate', name: 'duplicate_webhook_idempotent', chip: 'evt_1Qx9 ×2', open: true, app: true, icon: 'copy', lx: 79.857, ly: 36.132, align: 'start', sx: 74.012, sy: 38.408 },
	{ id: 'seats', name: 'seat_qty_vs_db_cap', chip: 'quantity: 3', open: true, app: true, icon: 'users', lx: 79.857, ly: 58.079, align: 'start', sx: 74.012, sy: 57.118 },
	{ id: 'race', name: 'upgrade_plus_cancel_race', chip: 'upgrade + cancel', open: true, app: true, icon: 'bolt', lx: 68.179, ly: 75.842, align: 'start', sx: 64.071, sy: 72.25 },
	{ id: 'period', name: 'cancel_at_period_end_keeps_access_until_end', chip: 'cancel_at_period_end', open: true, app: true, icon: 'calendar', lx: 40.476, ly: 84.737, align: 'center', sx: 47.976, sy: 78.026 },
	{ id: 'cancel', name: 'cancel_revokes_access', chip: 'subscription.deleted', open: false, app: false, icon: 'prohibit', lx: 12.774, ly: 75.842, align: 'end', sx: 31.881, sy: 72.25 },
	{ id: 'refund', name: 'refund_revokes_access', chip: 'charge.refunded', open: false, app: false, icon: 'refund', lx: 1.095, ly: 58.079, align: 'end', sx: 21.94, sy: 57.118 },
	{ id: 'dispute', name: 'dispute_revokes_or_flags', chip: 'charge.dispute.created', open: false, app: true, leak: true, icon: 'gavel', lx: 1.095, ly: 36.132, align: 'end', sx: 21.94, sy: 38.408 },
	{ id: 'due', name: 'past_due_denies_until_recovery', chip: 'payment_failed', open: false, app: false, recover: true, icon: 'warning', lx: 12.774, ly: 18.368, align: 'end', sx: 31.881, sy: 23.276 },
];

const CX = 420;
const CY = 380;
const RO = 230;
const RI = 202;

function xy(r: number, deg: number) {
	const a = (deg * Math.PI) / 180;
	return [CX + r * Math.sin(a), CY - r * Math.cos(a)];
}

function arc(r: number, a0: number, a1: number) {
	const [x0, y0] = xy(r, a0);
	const [x1, y1] = xy(r, a1);
	const large = a1 - a0 > 180 ? 1 : 0;
	const n = (v: number) => v.toFixed(1);
	return `M ${n(x0)} ${n(y0)} A ${r} ${r} 0 ${large} 1 ${n(x1)} ${n(y1)}`;
}

const segments = stations.flatMap((station, i) => {
	const a0 = i * 36 + 6;
	const a1 = (i + 1) * 36 - 6;
	const expected = station.open ? '#3fcf8e' : '#f2555a';
	const app = station.app ? '#3fcf8e' : '#f2555a';
	const parts: { d: string; stroke: string; width: number; opacity: number }[] = [];
	if (station.recover) {
		parts.push({ d: arc(RO, a0, a0 + 16), stroke: '#f2555a', width: 16, opacity: 1 });
		parts.push({ d: arc(RI, a0, a0 + 16), stroke: '#f2555a', width: 4, opacity: 0.8 });
		parts.push({ d: arc(RO, a0 + 16, a1), stroke: '#3fcf8e', width: 16, opacity: 1 });
		parts.push({ d: arc(RI, a0 + 16, a1), stroke: '#3fcf8e', width: 4, opacity: 0.8 });
		return parts;
	}
	parts.push({ d: arc(RO, a0, a1), stroke: expected, width: 16, opacity: 1 });
	if (station.leak) {
		parts.push({ d: arc(RI, a0, a1), stroke: '#f2555a', width: 12, opacity: 0.35 });
		parts.push({ d: arc(RI, a0, a1), stroke: '#3fcf8e', width: 4, opacity: 1 });
	} else {
		parts.push({ d: arc(RI, a0, a1), stroke: app, width: 4, opacity: 0.8 });
	}
	return parts;
});

const scrubber = arc(RO, -8, 8);
const leftPie = 'M 420 80 A 300 300 0 0 0 420 680 L 420 380 Z';
const rightPie = 'M 420 80 A 300 300 0 0 1 420 680 L 420 380 Z';

function glyph(name: string) {
	return `<svg viewBox="0 0 256 256" width="100%" height="100%" aria-hidden="true" focusable="false"><path d="${icons[name]}"/></svg>`;
}

function nameParts(name: string) {
	return name.split('_');
}
---

<div class:list={['dial-block', card && 'is-mobile']} id={card ? 'access-dial-mobile' : undefined}>
	<div class:list={['access-dial', labels ? 'is-stage' : 'is-mobile']} id={labels ? 'access-dial' : undefined}>
		<svg class="dial-svg" viewBox="0 0 840 760" aria-hidden="true">
			<circle cx="420" cy="380" r="230" fill="none" stroke="#ffffff" stroke-opacity="0.06" stroke-width="16" />
			<circle cx="420" cy="380" r="202" fill="none" stroke="#ffffff" stroke-opacity="0.06" stroke-width="4" />
			<mask id={`${uid}-outer`} maskUnits="userSpaceOnUse" x="0" y="0" width="840" height="760">
				<rect width="840" height="760" fill="#000" />
				<g class="dial-mask-spin dial-spin">
					<path d={leftPie} fill="#fff" />
				</g>
				<path class="dial-mask-cover" d={leftPie} fill="#000" />
				<path class="dial-mask-fill" d={rightPie} fill="#fff" />
			</mask>
			<mask id={`${uid}-inner`} maskUnits="userSpaceOnUse" x="0" y="0" width="840" height="760">
				<rect width="840" height="760" fill="#000" />
				<g class="dial-mask-spin dial-spin-lag">
					<path d={leftPie} fill="#fff" />
				</g>
				<path class="dial-mask-cover-lag" d={leftPie} fill="#000" />
				<path class="dial-mask-fill-lag" d={rightPie} fill="#fff" />
			</mask>
			<g mask={`url(#${uid}-outer)`}>
				{segments.filter((seg) => seg.width > 8).map((seg) => (
					<path d={seg.d} fill="none" stroke={seg.stroke} stroke-width={seg.width} stroke-opacity={seg.opacity} stroke-linecap="round" />
				))}
			</g>
			<g mask={`url(#${uid}-inner)`}>
				{segments.filter((seg) => seg.width < 8 || seg.opacity < 0.5).map((seg) => (
					<path d={seg.d} fill="none" stroke={seg.stroke} stroke-width={seg.width} stroke-opacity={seg.opacity} stroke-linecap="round" />
				))}
			</g>
			<g class="dial-scrubber">
				<path d={scrubber} fill="none" stroke="#f5b83d" stroke-width="16" stroke-linecap="round" />
			</g>
		</svg>

		<span class="dial-halo" aria-hidden="true"></span>

		{stations.map((station, i) => (
			<span
				class="dial-station"
				data-id={station.id}
				data-i={i}
				style={`left:${station.sx}%;top:${station.sy}%;--dial-color:${station.open ? '#3fcf8e' : '#f2555a'}`}
				aria-hidden="true"
			>
				<span class="dial-ico" set:html={glyph(station.icon)} />
				<span class="dial-lit">
					<span class="dial-ico" set:html={glyph(station.icon)} />
				</span>
			</span>
		))}

		{labels && stations.map((station, i) => {
			const parts = nameParts(station.name);
			const wrap = station.align === 'end' && parts.length >= 4;
			const gap = station.leak ? '3.4cqw' : '2.4cqw';
			const style = station.align === 'end'
				? `top:${station.ly}%;left:auto;right:calc(${(100 - station.sx).toFixed(3)}% + ${gap} + 12px);width:max-content`
				: station.align === 'start'
					? `top:${station.ly}%;left:calc(${station.sx}% + 2.4cqw + 12px);width:max-content;max-width:calc(100% - ${station.sx}% - 2.4cqw - 24px)`
					: `left:${station.lx}%;top:${station.ly}%`;
			return (
				<span
					class:list={['dial-label', `is-${station.align}`]}
					data-id={station.id}
					data-i={i}
					style={style}
				>
					<span class="dial-chip">{station.chip}</span>
					<span class="dial-name">
						{wrap ? (
							<>
								{parts.slice(0, -1).join('_')}_<br />{parts[parts.length - 1]}
							</>
						) : parts.map((part, index, all) => (
							<>
								{part}
								{index < all.length - 1 && <>_<wbr /></>}
							</>
						))}
					</span>
					{station.leak && (
						<span class="dial-leak dial-leak-label">
							<span class="dial-ico" set:html={glyph('x')} />
							<span>leak caught</span>
						</span>
					)}
				</span>
			);
		})}

		<div class="dial-center">
			<div class="dial-locks" aria-hidden="true">
				<span class="dial-center-halo" aria-hidden="true"></span>
				<span class="dial-lock dial-lock-idle" set:html={glyph('lock')} />
				<span class="dial-lock dial-lock-open" set:html={glyph('open')} />
				<span class="dial-lock dial-lock-shut" set:html={glyph('lock')} />
			</div>
			<span class="dial-kicker">access_row</span>
			<div class="dial-readout">
				<div class="dial-swap">
					<span class="dial-center-label dial-count">0 / 10 events</span>
					{stations.map((station, i) => (
						<span class="dial-center-label" data-id={station.id} data-i={i}>
							<span class="dial-center-chip" data-id={station.id} data-i={i}>{station.chip}</span>
							{station.leak && (
								<span class="dial-leak dial-leak-center">
									<span class="dial-ico" set:html={glyph('x')} />
									<span>leak caught</span>
								</span>
							)}
						</span>
					))}
					<span class="dial-center-label dial-badges">
						<span class="dial-badge dial-badge-pass">
							<span class="dial-ico" set:html={glyph('check')} />
							<span>9 pass</span>
						</span>
						<span class="dial-badge dial-badge-fail">
							<span class="dial-ico" set:html={glyph('x')} />
							<span>1 leak</span>
						</span>
					</span>
				</div>
			</div>
		</div>
	</div>

	{card && (
		<div class="dial-card">
			<span class="dial-card-alert" aria-hidden="true"></span>
			<div class="dial-card-face dial-card-idle">
				<span class="dial-card-kicker">0 / 10 events</span>
			</div>
			{stations.map((station, i) => (
				<div class="dial-card-face" data-id={station.id} data-i={i}>
					<div class="dial-card-head">
						<span class="dial-card-mark" style={`--dial-color:${station.open ? '#3fcf8e' : '#f2555a'}`} set:html={glyph(station.icon)} />
						<span class="dial-card-copy">
							<span class="dial-card-chip">{station.chip}</span>
							<span class="dial-card-name">
								{nameParts(station.name).map((part, index, all) => (
									<>
										{part}
										{index < all.length - 1 && <>_<wbr /></>}
									</>
								))}
							</span>
						</span>
					</div>
					<div class="dial-card-rows">
						<span class="dial-card-row">
							<span class="dial-card-kicker">expected</span>
							<span class:list={['dial-mini', station.open ? 'is-open' : 'is-locked']} set:html={glyph(station.open ? 'open' : 'lock')} />
						</span>
						<span class="dial-card-row">
							<span class="dial-card-kicker">your app</span>
							<span class:list={['dial-mini', station.app ? 'is-open' : 'is-locked']} set:html={glyph(station.app ? 'open' : 'lock')} />
						</span>
					</div>
					{station.leak && (
						<span class="dial-leak dial-leak-label">
							<span class="dial-ico" set:html={glyph('x')} />
							<span>leak caught</span>
						</span>
					)}
				</div>
			))}
		</div>
	)}
</div>
