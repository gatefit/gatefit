---
import { resolvePolarCheckoutUrl } from '../lib/polarCheckout';

const checkoutUrl = resolvePolarCheckoutUrl(import.meta.env.PUBLIC_POLAR_CHECKOUT_URL);
---

{
	checkoutUrl ? (
		<>
			<p>
				<a
					class="gatefit-polar-cta"
					href={checkoutUrl}
					data-polar-checkout
					data-polar-checkout-theme="light">Get indie license</a
				>
			</p>
			<script
				is:inline
				defer
				data-auto-init
				src="https://cdn.jsdelivr.net/npm/@polar-sh/checkout@latest/dist/embed.global.js"
			></script>
			<p>
				Polar checkout is live: Gatefit Indie License, $49 one-time. Polar is the merchant of
				record. npm and the GitHub Action stay free.
			</p>
		</>
	) : (
		<p role="status" data-polar-checkout-pending>
			This <code>PUBLIC_POLAR_CHECKOUT_URL</code> is not a Checkout Link, so the Buy CTA stays
			closed. Product paths, polar.sh home, and other hosts fail closed. npm and the GitHub Action
			stay free.
		</p>
	)
}

<style>
	.gatefit-polar-cta {
		display: inline-block;
		padding: 0.6rem 1.1rem;
		border-radius: 999px;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-black);
		text-decoration: none;
		font-weight: 600;
	}
</style>
