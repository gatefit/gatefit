---
import { resolvePolarCheckoutUrl } from '../lib/polarCheckout';

interface Props {
	label?: string;
	closedNote?: boolean;
	size?: 'nav' | 'lg';
}

const { label = 'Buy for $49', closedNote = false, size = 'lg' } = Astro.props;
const checkoutUrl = resolvePolarCheckoutUrl(import.meta.env.PUBLIC_POLAR_CHECKOUT_URL);
---

{
	checkoutUrl ? (
		<span class:list={['buy-wrap', size === 'nav' && 'buy-wrap-nav']}>
			<a
				class:list={['buy', size === 'nav' && 'buy-nav']}
				href={checkoutUrl}
				target="_blank"
				rel="noopener"
			>
				{label}
			</a>
		</span>
	) : (
		<span
			class:list={['buy', 'is-closed', size === 'nav' && 'buy-nav']}
			role="status"
			data-checkout-closed
		>
			{label}
		</span>
	)
}
{
	closedNote && !checkoutUrl && (
		<p role="status" data-checkout-closed>
			This <code>PUBLIC_POLAR_CHECKOUT_URL</code> is not a Checkout Link, so the Buy CTA stays
			closed. Product paths, polar.sh home, and other hosts fail closed. npm and the GitHub Action
			stay free.
		</p>
	)
}
