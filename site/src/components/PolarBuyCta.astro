---
import { resolvePolarCheckoutUrl } from '../lib/polarCheckout';

const checkoutUrl = resolvePolarCheckoutUrl(import.meta.env.PUBLIC_POLAR_CHECKOUT_URL);
---

{
	checkoutUrl ? (
		<>
			<p>
				<a
					class="gatefit-polar-cta"
					href={checkoutUrl}
					data-polar-checkout
					data-polar-checkout-theme="light">Get indie license</a
				>
			</p>
			<script
				is:inline
				defer
				data-auto-init
				src="https://cdn.jsdelivr.net/npm/@polar-sh/checkout@latest/dist/embed.global.js"
			></script>
			<p>
				Polar is the merchant of record. npm and the GitHub Action stay free.
			</p>
		</>
	) : (
		<p role="status" data-polar-checkout-pending>
			Polar checkout is coming soon. Indie license checkout is not live until
			<code>PUBLIC_POLAR_CHECKOUT_URL</code> is a Polar Checkout Link
			(<code>https://buy.polar.sh/polar_cl_…</code>). A product path is not checkout. npm and the
			GitHub Action stay free.
		</p>
	)
}

<style>
	.gatefit-polar-cta {
		display: inline-block;
		padding: 0.6rem 1.1rem;
		border-radius: 999px;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-black);
		text-decoration: none;
		font-weight: 600;
	}
</style>
