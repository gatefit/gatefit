---
import '../styles/landing.css';
import Icon from '../components/Icon.astro';
import PolarBuyCta from '../components/PolarBuyCta.astro';
import mark from '../assets/gatefit-mark.svg?raw';
import { landingSets, loadStripeGoldens } from '../lib/stripeGoldens';

const initCmd = 'npx gatefit init';

// Break golden ids after underscores so a narrow column wraps at the word, not mid-token.
function goldenId(id: string): string {
	if (!/^[a-z0-9]+(?:_[a-z0-9]+)*$/.test(id)) throw new Error(`unexpected golden id ${id}`);
	return id.replaceAll('_', '_<wbr>');
}

// The replay in the hero frame: one customer, three Stripe events, the row each one should leave.
const events = [
	{ name: 'customer.subscription.created', want: 'trialing', ok: true },
	{ name: 'invoice.paid', want: 'active', ok: true },
	{ name: 'charge.refunded', want: 'refunded', ok: false },
];

const steps = [
	{ icon: 'lightning', n: '01', h: 'Replays the Stripe event', chip: 'charge.refunded', tone: 'event' },
	{ icon: 'code', n: '02', h: 'Runs your access adapter', chip: 'adapter.apply(event)', tone: 'code' },
	{ icon: 'database', n: '03', h: 'Checks the access row', chip: 'locked: true', tone: 'row' },
] as const;

// Display order from phase A. Membership and the totals come from the golden files.
const sets = landingSets(
	loadStripeGoldens(),
	[
		'refund_revokes_access',
		'cancel_revokes_access',
		'paid_grants_access',
		'trial_to_paid_grants',
		'past_due_denies_until_recovery',
		'duplicate_webhook_idempotent',
		'trial_no_card',
		'portal_downgrade_period_end_vs_immediate',
		'entitlements_active_summary',
	],
	[
		'seat_qty_vs_db_cap',
		'cancel_at_period_end_keeps_access_until_end',
		'upgrade_plus_cape_race',
		'dispute_revokes_or_flags',
		'unpaid_after_retries_revokes',
	],
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Gatefit: CI for your Stripe access table</title>
		<meta name="description" content="CI that asserts the access DB survives ugly billing transitions." />
		<meta name="theme-color" content="#0B1B3A" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Gatefit" />
		<meta property="og:title" content="Gatefit" />
		<meta property="og:description" content="CI that asserts the access DB survives ugly billing transitions." />
		<meta property="og:url" content="https://gatefit.io/" />
		<meta property="og:image" content="https://gatefit.io/og.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Gatefit. CI that asserts the access DB survives ugly billing transitions." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content="https://gatefit.io/og.png" />
		<!-- Cloudflare Web Analytics --><script is:inline defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "82ff14a5563c492d869b6db741aac128"}'></script><!-- End Cloudflare Web Analytics -->
	</head>
	<body class="landing">
		<a class="skip" href="#hero">Skip to content</a>
		<header class="site-nav">
			<div class="wrap">
				<a class="word" href="/"><span class="mark" set:html={mark} />Gatefit</a>
				<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
					<span class="nav-toggle-open">Menu</span>
					<span class="nav-toggle-close">Close</span>
				</button>
				<nav class="nav-links" id="nav-links" aria-label="Primary">
					<a class="nav-link" href="/quickstart/">Quickstart</a>
					<a class="nav-link" href="/action/">Action</a>
					<a class="nav-link" href="#pricing">Pricing</a>
					<a class="nav-link" href="/status/">Status</a>
				</nav>
				<PolarBuyCta size="nav" label="Buy for $49" />
			</div>
		</header>

		<main id="hero">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-grid" aria-hidden="true"></div>
				<div class="wrap">
					<div class="hero-copy">
						<p class="eyebrow"><span class="pip"></span>Stripe → access DB → CI</p>
						<h1 id="hero-title">CI tests for the access table behind your Stripe paywall.</h1>
						<p class="hero-sub">Gatefit replays refunds, disputes, duplicate webhooks and <code>past_due</code> in CI and checks the access row your app writes. A 200 from Stripe is not access.</p>
						<div class="hero-cta">
							<button type="button" class="cmd" data-copy={initCmd} aria-label={`Copy ${initCmd}`}>
								<span class="cmd-prompt" aria-hidden="true">$</span>
								<code>{initCmd}</code>
								<span class="cmd-icon" aria-hidden="true"><span class="i-copy"><Icon name="copy" size={16} /></span><span class="i-done"><Icon name="check" size={16} /></span></span>
							</button>
							<PolarBuyCta closedNote label="Buy for $49" />
						</div>
						<p class="cmd-status" role="status" aria-live="polite"></p>
						<ul class="facts">
							<li><Icon name="check" size={16} /> {sets.total} transitions free</li>
							<li><Icon name="check" size={16} /> GitHub Action</li>
							<li><Icon name="check" size={16} /> $49 one-time</li>
						</ul>
					</div>

					<figure class="frame" aria-label="Example run. A Gatefit replay of a refund against the access table. Not a live result.">
						<div class="frame-bar">
							<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
							<span class="frame-title"><span class="frame-example">example run</span> · <span class="mono">cus_9fQ2</span></span>
							<span class="frame-tag bad">1 failed</span>
						</div>
						<div class="frame-body">
							<div class="col">
								<p class="col-h"><Icon name="lightning" size={14} /> Stripe events</p>
								<ol class="events">
									{events.map((e, i) => (
										<li class:list={['ev', !e.ok && 'ev-bad']}>
											<span class="ev-n">{i + 1}</span>
											<span class="ev-name">{e.name}</span>
										</li>
									))}
								</ol>
							</div>
							<div class="col">
								<p class="col-h"><Icon name="database" size={14} /> access_rows</p>
								<table class="rows">
									<thead><tr><th>field</th><th>expected</th><th>actual</th></tr></thead>
									<tbody>
										<tr><td>plan</td><td>pro</td><td>pro</td></tr>
										<tr><td>status</td><td>refunded</td><td>refunded</td></tr>
										<tr class="row-bad"><td class="k">locked</td><td class="want">true</td><td class="got">false</td></tr>
									</tbody>
								</table>
							</div>
						</div>
						<ol class="run-log leak-stack">
							<li class="ok"><Icon name="check" size={14} /> paid_grants_access</li>
							<li class="ok"><Icon name="check" size={14} /> trial_to_paid_grants</li>
							<li class="bad"><Icon name="x" size={14} /> refund_revokes_access <span class="dim">expected locked: true</span></li>
							<li class="sum"><Icon name="git-pull-request" size={14} /> {sets.total - 1} passed · 1 failed · merge blocked</li>
						</ol>
					</figure>
				</div>
			</section>

			<section class="section how" id="how" aria-labelledby="how-title">
				<div class="wrap">
					<div class="head">
						<h2 id="how-title">How a Gatefit run works</h2>
						<p class="lede">Stripe events go in. Your adapter writes the row. Gatefit checks the access row, not the webhook.</p>
					</div>
					<ol class="strip">
						{steps.map((s) => (
							<li class="step">
								<span class="step-top"><span class="step-icon"><Icon name={s.icon} size={20} /></span><span class="step-n">{s.n}</span></span>
								<h3>{s.h}</h3>
								<span class:list={['chip', `chip-${s.tone}`]}>{s.chip}</span>
							</li>
						))}
					</ol>
					<div class="verdict-bar">
						<span class="v v-bad"><Icon name="x" size={16} /> <code>locked: false</code> fails the build</span>
						<span class="v v-ok"><Icon name="check" size={16} /> <code>locked: true</code> passes, exit 0</span>
					</div>
				</div>
			</section>

			<section class="section goldens" id="goldens" aria-labelledby="goldens-title">
				<div class="wrap">
					<div class="head">
						<h2 id="goldens-title">{sets.total} Stripe transitions, checked for free</h2>
						<p class="lede">Each golden is a named transition with the access row it must leave. A naive adapter fails them.</p>
					</div>
					<div class="golden-sets">
						<div class="set">
							<p class="set-h"><span>{sets.sLabel}</span><span class="count">{sets.free.length}</span></p>
							<ul class="tags">{sets.free.map((g) => <li><Icon name="check" size={14} /><span class="tag-id" set:html={goldenId(g)} /></li>)}</ul>
						</div>
						<div class="set">
							<p class="set-h"><span>Phase 2</span><span class="count">{sets.phase2.length}</span></p>
							<ul class="tags">{sets.phase2.map((g) => <li><Icon name="check" size={14} /><span class="tag-id" set:html={goldenId(g)} /></li>)}</ul>
						</div>
					</div>
					<a class="quiet" href="/goldens/">See every golden <Icon name="arrow-right" size={16} /></a>
				</div>
			</section>

			<section class="section pricing" id="pricing" aria-labelledby="pricing-title">
				<div class="wrap">
					<div class="head">
						<h2 id="pricing-title">Free core, $49 for chaos mode and packs</h2>
						<p class="lede">The CLI, the Action and the Stripe goldens ({sets.sLabel} and Phase 2) stay free. Polar and Paddle pack goldens are on the Indie License, a one-time Polar checkout.</p>
					</div>
					<div class="prices">
						<article class="price-card">
							<p class="tier">Free</p>
							<p class="amount">$0</p>
							<ul class="ticks">
								<li><Icon name="check" size={16} /> <code>npx gatefit</code> and the GitHub Action</li>
								<li><Icon name="check" size={16} /> <code>gatefit init</code> adapter scaffold</li>
								<li><Icon name="check" size={16} /> {sets.sLabel} goldens</li>
								<li><Icon name="check" size={16} /> Phase 2 goldens</li>
							</ul>
							<a class="quiet" href="/quickstart/">Read the quickstart <Icon name="arrow-right" size={16} /></a>
						</article>
						<article class="price-card indie">
							<p class="tier">Indie License</p>
							<p class="amount">$49 <span class="amount-note">one-time</span></p>
							<ul class="ticks">
								<li>Unlocks chaos mode, Polar and Paddle packs</li>
								<li>Everything in Free</li>
							</ul>
							<div class="suites" aria-label="Suites the license unlocks">
								<span class="suite"><Icon name="shuffle" size={16} /><code>--suite chaos</code></span>
								<span class="suite"><Icon name="package" size={16} /><code>--suite polar</code></span>
								<span class="suite"><Icon name="package" size={16} /><code>--suite paddle</code></span>
							</div>
							<PolarBuyCta label="Buy for $49" />
						</article>
					</div>
					<p class="fine">Chaos mode checks the access row when deliveries are duplicated, reordered, stale, late, or dropped.</p>
				</div>
			</section>

			<section class="section final" id="final" aria-labelledby="final-title">
				<div class="wrap">
					<div class="final-band">
						<div>
							<h2 id="final-title">Ship the gate before the refund</h2>
							<p class="lede">Run the free CLI today, or buy the Indie License for chaos mode and the Polar and Paddle packs.</p>
						</div>
						<div class="hero-cta">
							<PolarBuyCta label="Buy for $49" />
							<a class="quiet" href="/quickstart/">Read the quickstart <Icon name="arrow-right" size={16} /></a>
						</div>
					</div>
					<a class="status-card" href="/status/">
						<span class="status-dot" aria-hidden="true"></span>
						<span><strong>Service status</strong><span class="dim">Uptime for the site, npm, Action, Polar and telemetry</span></span>
						<Icon name="arrow-right" size={18} />
					</a>
				</div>
			</section>
		</main>

		<footer class="site-foot">
			<div class="wrap">
				<a class="word" href="/"><span class="mark" set:html={mark} />Gatefit</a>
				<div class="foot-links">
					<a href="/quickstart/">Quickstart</a>
					<a href="/init/">gatefit init</a>
					<a href="/polar-pack/">Polar pack</a>
					<a href="/paddle-pack/">Paddle pack</a>
					<a href="/telemetry/">Telemetry</a>
					<a href="/status/">Status</a>
					<a href="https://github.com/gatefit/gatefit" aria-label="GitHub"><Icon name="github-logo" size={18} /></a>
				</div>
			</div>
		</footer>

		<script>
			const nav = document.querySelector<HTMLElement>('.site-nav');
			const navToggle = nav?.querySelector<HTMLButtonElement>('.nav-toggle');
			const navLinks = nav?.querySelector<HTMLElement>('#nav-links');
			const setNavOpen = (open: boolean) => {
				nav?.classList.toggle('is-open', open);
				document.documentElement.classList.toggle('nav-open', open);
				navToggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
			};
			navToggle?.addEventListener('click', () => {
				const open = navToggle.getAttribute('aria-expanded') !== 'true';
				setNavOpen(open);
				if (open) navLinks?.querySelector('a')?.focus({ preventScroll: true });
			});
			document.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape' || !nav?.classList.contains('is-open')) return;
				setNavOpen(false);
				navToggle?.focus({ preventScroll: true });
			});
			navLinks?.addEventListener('click', (event) => {
				const target = event.target;
				if (target instanceof Element && target.closest('a')) setNavOpen(false);
			});
			// Count Buy clicks. Fire-and-forget: navigation to the Checkout Link is never
			// blocked or changed, and nothing is stored in the browser.
			document.addEventListener('click', (event) => {
				const target = event.target;
				if (!(target instanceof Element) || !target.closest('a[data-gf-buy]')) return;
				try {
					navigator.sendBeacon?.('https://t.gatefit.io/v1/site', '{"event":"buy_click"}');
				} catch {}
			});
			// Copy the init command. Clipboard API first; a hidden textarea when it is missing or refused.
			const status = document.querySelector<HTMLElement>('.cmd-status');
			const fallbackCopy = (text: string) => {
				const area = document.createElement('textarea');
				area.value = text;
				area.setAttribute('readonly', '');
				area.style.position = 'fixed';
				area.style.opacity = '0';
				document.body.append(area);
				area.select();
				const done = document.execCommand('copy');
				area.remove();
				return done;
			};
			for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
				let timer = 0;
				button.addEventListener('click', async () => {
					const text = button.dataset.copy ?? '';
					let done = false;
					try {
						await navigator.clipboard.writeText(text);
						done = true;
					} catch {
						done = fallbackCopy(text);
					}
					button.classList.toggle('is-copied', done);
					if (status) status.textContent = done ? `Copied: ${text}` : `Copy failed. Run: ${text}`;
					clearTimeout(timer);
					timer = window.setTimeout(() => button.classList.remove('is-copied'), 1800);
				});
			}
		</script>
	</body>
</html>
