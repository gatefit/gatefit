{
  "name": "gatefit",
  "version": "0.4.0",
  "description": "Stripe Entitlement Edge Pack — CI that asserts the access DB survives ugly billing transitions",
  "type": "module",
  "license": "MIT",
  "author": "gatefit",
  "bin": {
    "gatefit": "./bin/gatefit.js"
  },
  "files": [
    "bin",
    "src",
    "tests/entitlements/goldens",
    "action.yml",
    "scripts/action-run.sh",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gatefit": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/entitlements/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gatefit/gatefit.git"
  },
  "bugs": {
    "url": "https://github.com/gatefit/gatefit/issues"
  },
  "homepage": "https://github.com/gatefit/gatefit#readme",
  "keywords": [
    "stripe",
    "entitlements",
    "access",
    "ci",
    "webhooks",
    "billing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.20.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
